# PayPal SANDBOX REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# Fianza refuses to run against production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Where this app is reachable (used for PayPal return/cancel URLs).
APP_BASE_URL=http://localhost:3000

# Express review bond amount in USD.
BOND_AMOUNT_USD=5.00

# Webhook id from the sandbox app (Developer Dashboard → your app → Webhooks).
# For events from the Webhooks simulator, use the literal WEBHOOK_ID.
PAYPAL_WEBHOOK_ID=

# Claim-checker (Claude Opus 5.5). Server-side only; judges never need their own key.
ANTHROPIC_API_KEY=

# GitHub App (Settings → Developer settings → GitHub Apps). Events: pull_request, check_suite, issue_comment.
# Permissions: pull requests (write), issues (write), checks (read), metadata (read).
GITHUB_APP_ID=
# Paste the PEM with literal \n for newlines when the host only accepts one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
FIANZA_MONTHLY_FORFEIT_CAP=5

# Postgres connection string (Render sets it from the database). Unset = in-memory store, lost on restart.
DATABASE_URL=

# Shared secret for POST /api/cron/reconcile, which voids holds nobody decided on within 48 hours.
CRON_SECRET=
